{
  "name": "abaninja-mcp",
  "version": "0.1.1",
  "private": true,
  "description": "Unofficial MCP server for AbaNinja: gives AI assistants access to an AbaNinja account through the official REST API.",
  "license": "MIT",
  "author": "INGENIUMDESIGN",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "catalog": "node scripts/generate-catalog.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "live": "npm run build && node scripts/live-test.mjs",
    "prepare": "npm run build",
    "bundle": "npm run build && node scripts/build-mcpb.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
