{
  "name": "abaninja-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial MCP server for AbaNinja: gives AI assistants access to an AbaNinja account through the official REST API.",
  "license": "MIT",
  "author": "INGENIUMDESIGN",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingeniumdesign/abaninja-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "abaninja",
    "invoicing",
    "switzerland"
  ],
  "type": "module",
  "bin": {
    "abaninja-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "catalog",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "catalog": "node scripts/generate-catalog.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
